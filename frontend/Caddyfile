{
	# Local CA for HTTPS on localhost. Use a real domain + ACME (or your own certs) when deployed.
	local_certs
	skip_install_trust
	auto_https disable_redirects
}

{$KATRA_SITE_ADDRESS:localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	# The API and the /admin data browser set their own Content-Security-Policy.
	handle /api/* {
		reverse_proxy api:8000
	}

	handle /admin* {
		reverse_proxy api:8000
	}

	handle {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
